# 초보자 안내: .gitignore는 Git이 추적하지 않을 파일/폴더 목록입니다.
# 비밀번호 같은 민감 정보(.env)나, 설치하면 자동으로 생기는 폴더(node_modules 등)는
# 깃허브에 올리지 않는 것이 안전하고, 저장소 용량도 아낄 수 있습니다.

# ===== 환경 변수 / 비밀 정보 =====
.env
.env.*
!.env.example

# ===== Python (backend) =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== Node / Frontend =====
node_modules/
.next/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# ===== 편집기 / OS 설정 파일 =====
.vscode/
.idea/
.DS_Store
Thumbs.db
