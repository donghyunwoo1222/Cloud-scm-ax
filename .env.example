# 환경 변수 예시 파일. 복사해서 .env 로 만든 뒤 값을 채운다 (.env 는 Git에 올라가지 않는다)
#   PowerShell: Copy-Item .env.example .env

# DB 주소. 어디서 실행하느냐에 따라 호스트·포트가 다르다
#  - 내 컴퓨터에서 pytest·Alembic 을 돌릴 때: localhost:5433  (아래 값, .env 에 이 값을 둔다)
#  - 백엔드가 Docker 안에서 돌 때:           db:5432        (docker-compose.yml 이 직접 넣으므로 .env 에 적지 않는다)
# 형식: postgresql+psycopg://사용자:비밀번호@호스트:포트/DB이름
DATABASE_URL=postgresql+psycopg://scm:scm_local_pw@localhost:5433/scm

# 로그인 토큰 서명 키. 아무도 모르는 32자 이상 임의 문자열로 바꾼다 (32자 미만이면 백엔드가 시작하지 않는다)
#   만드는 법: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# 쿠키를 HTTPS로만 보낼지. 로컬은 false, 배포(HTTPS)에서는 true
COOKIE_SECURE=false

# 발주서 메일 발송(#158). 로컬 Docker 는 docker-compose.yml 이 가짜 메일함(mailpit)으로 넣으므로 비워 둔다
# 배포에서만 실제 값을 넣는다. 비밀번호는 코드·Git 에 넣지 않는다. SMTP_HOST 가 비면 메일 보내기는 503
# 비밀번호 재설정 메일(#170)의 링크 앞부분. 배포 주소로 정한다. 비면 재설정 요청은 503
# APP_BASE_URL=https://scm.example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_SECURITY=starttls   # starttls(587) / ssl(465) / none(로컬 전용)

# LLM 공통 호출(#180). 기본은 꺼짐: 셋 중 하나라도 false/0 이면 LLM 을 부르지 않고 "직접 입력해 주세요"로 안내한다
# 한도 0 은 "무제한"이 아니라 "꺼짐"이다. 제공자 대시보드의 결제 한도도 따로 건다(서버 메모리 한도는 재시작하면 초기화)
# LLM_ENABLED=false                 # 전체 스위치(kill switch)
# LLM_DAILY_CALLS_PER_COMPANY=0     # 회사별 하루 호출 수(재시도도 1번으로 센다)
# LLM_MONTHLY_BUDGET_USD=0          # 전체 월 비용 한도(달러, 서울 기준 달). 무료 키도 켜려면 0보다 큰 값
# Gemini 연결. 키와 모델 이름이 둘 다 있어야 연결된다(모델 이름은 코드에 기본값이 없다. 무료 등급 모델은 AI Studio 에서 확인)
# 주의: 무료 키의 입력은 구글의 학습·검수에 쓰일 수 있다. 민감 데이터(실제 고객·거래처·가격 등)는 보내지 않는다.
#       실제 고객 데이터는 결제를 연결한 유료 키가 필요하다(키 값만 바꾸면 된다). 키는 Git·로그·채팅에 남기지 않는다
# LLM_API_KEY=                      # Gemini API 키 (x-goog-api-key 헤더로만 보낸다)
# LLM_MODEL=                        # Gemini 모델 이름
# 아래는 비우면 괄호 안 기본값을 쓴다
# LLM_TIMEOUT_SECONDS=8             # 한 번 시도에서 기다리는 최대 초
# LLM_DEADLINE_SECONDS=20           # 재시도 대기까지 합친 마감 초
# LLM_MAX_RETRIES=2                 # 429·5xx·시간 초과 때 다시 시도하는 횟수
# LLM_RETRY_WAIT_SECONDS=0.5        # 첫 재시도 전 대기 초 (다음은 2배씩)
# LLM_MAX_INPUT_CHARS=20000         # 보내는 데이터(JSON 글자 수) 상한
# LLM_MAX_OUTPUT_TOKENS=1024        # 출력 토큰 상한
# LLM_MAX_RESPONSE_BYTES=200000     # 받는 응답 크기 상한(바이트)
# LLM_PRICE_INPUT_USD_PER_MTOK=0    # 입력 100만 토큰당 달러 (무료 키 0, 유료로 바꾸면 요금표 값)
# LLM_PRICE_OUTPUT_USD_PER_MTOK=0   # 출력 100만 토큰당 달러
